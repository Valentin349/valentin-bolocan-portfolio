---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/date';

interface Props {
  frontmatter: {
    title: string;
    publishDate?: Date;
    tags?: string[];
    readingTime?: number;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} - Your Name`}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-12">
      <h1 class="mb-4">{frontmatter.title}</h1>

      <div class="flex flex-wrap gap-4 items-center text-sm text-text-muted">
        {frontmatter.publishDate && (
          <time datetime={frontmatter.publishDate.toISOString()}>
            {formatDate(frontmatter.publishDate)}
          </time>
        )}

        {frontmatter.readingTime && (
          <span>{frontmatter.readingTime} min read</span>
        )}

        {frontmatter.tags && frontmatter.tags.length > 0 && (
          <div class="flex gap-2">
            {frontmatter.tags.map(tag => (
              <span class="px-3 py-1 bg-surface rounded-full text-xs">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    <footer class="mt-16 pt-8 border-t border-border">
      <a href="/" class="text-text-muted hover:text-text transition-colors">
        ← Back to timeline
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .prose {
    @apply text-text;
  }

  .prose :global(h2) {
    @apply text-h2 mt-12 mb-4;
  }

  .prose :global(h3) {
    @apply text-h3 mt-8 mb-3;
  }

  .prose :global(p) {
    @apply mb-6;
  }

  .prose :global(ul),
  .prose :global(ol) {
    @apply mb-6 pl-6;
  }

  .prose :global(li) {
    @apply mb-2;
  }

  .prose :global(a) {
    @apply text-text underline decoration-border hover:decoration-accent;
  }

  .prose :global(blockquote) {
    @apply border-l-2 border-accent pl-6 italic text-text-muted my-6;
  }

  .prose :global(code) {
    @apply font-mono text-sm bg-surface px-1.5 py-0.5 rounded;
  }

  .prose :global(pre) {
    @apply font-mono text-sm bg-surface p-4 rounded-lg overflow-x-auto my-6;
  }

  .prose :global(img) {
    @apply rounded-lg my-8;
  }
</style>
