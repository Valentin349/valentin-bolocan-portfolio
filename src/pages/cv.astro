---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="CV - Valentin Bolocan"
  description="My curriculum vitae and professional experience"
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <article class="prose">
      <h1 class="mb-8">Curriculum Vitae</h1>

      <div class="space-y-12 text-text">
        <!-- Experience -->
        <section>
          <h2 class="mb-6">Experience</h2>

          <div class="space-y-8">
            <!-- Job 1 -->
            <div>
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h3 class="text-xl font-semibold mb-1">Senior Developer</h3>
                  <p class="text-text-muted">Company Name</p>
                </div>
                <span class="text-sm text-text-muted">2022 - Present</span>
              </div>
              <ul class="mt-3 space-y-2 text-text-muted">
                <li>Led development of key features and improvements</li>
                <li>Mentored junior developers and conducted code reviews</li>
                <li>Architected scalable solutions for growing user base</li>
              </ul>
            </div>

            <!-- Job 2 -->
            <div>
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h3 class="text-xl font-semibold mb-1">Developer</h3>
                  <p class="text-text-muted">Previous Company</p>
                </div>
                <span class="text-sm text-text-muted">2020 - 2022</span>
              </div>
              <ul class="mt-3 space-y-2 text-text-muted">
                <li>Built and maintained web applications</li>
                <li>Collaborated with design team on UI/UX improvements</li>
                <li>Implemented testing and CI/CD pipelines</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Education -->
        <section>
          <h2 class="mb-6">Education</h2>

          <div class="space-y-6">
            <div>
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h3 class="text-xl font-semibold mb-1">Bachelor's in Computer Science</h3>
                  <p class="text-text-muted">University Name</p>
                </div>
                <span class="text-sm text-text-muted">2016 - 2020</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Skills -->
        <section>
          <h2 class="mb-6">Skills</h2>

          <div class="space-y-4">
            <div>
              <h3 class="text-lg font-medium mb-2">Languages & Frameworks</h3>
              <div class="flex flex-wrap gap-2">
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">JavaScript</span>
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">TypeScript</span>
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">React</span>
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">Next.js</span>
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">Node.js</span>
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">Astro</span>
              </div>
            </div>

            <div>
              <h3 class="text-lg font-medium mb-2">Tools & Technologies</h3>
              <div class="flex flex-wrap gap-2">
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">Git</span>
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">Docker</span>
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">PostgreSQL</span>
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">Tailwind CSS</span>
                <span class="px-3 py-1 bg-surface rounded text-sm border border-border">Figma</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Download CV -->
        <section class="pt-8 border-t border-border">
          <a
            href="/cv.pdf"
            download
            class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-background rounded-lg hover:opacity-90 transition-opacity no-underline"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download CV as PDF
          </a>
          <p class="text-sm text-text-muted mt-3">
            Or view my full profile on <a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener noreferrer" class="underline">LinkedIn</a>
          </p>
        </section>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .prose p {
    @apply mb-6;
  }

  .prose h2 {
    @apply text-h2;
  }

  .prose h3 {
    @apply text-h3;
  }

  .prose ul {
    @apply pl-6 space-y-2;
  }

  .prose li {
    @apply mb-2;
  }

  .prose a {
    @apply text-text underline decoration-border hover:decoration-accent transition-colors;
  }
</style>
