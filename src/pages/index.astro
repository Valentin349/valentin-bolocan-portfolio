---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import TimelineFilters from '../components/TimelineFilters.astro';
import { getCollection } from 'astro:content';
import { mergeTimelineItems } from '../utils/timeline';

// Fetch all content
const blogPosts = await getCollection('blog');
const projects = await getCollection('projects');

// Merge and sort timeline items
const timelineItems = mergeTimelineItems(blogPosts, projects, []);
---

<BaseLayout
  title="Your Name - Timeline"
  description="A timeline of my work, thoughts, and experiments. Building in public."
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <!-- Hero section -->
    <header class="mb-24">
      <h1 class="mb-6">Building and sharing the journey.</h1>
      <p class="text-xl text-text-muted max-w-2xl leading-relaxed mb-6">
        This is my timeline, a collection of projects, blog posts, and experiments.
        Not everything here is polished or finished. That's by design.
      </p>

      <!-- Social links -->
      <div class="flex gap-6 items-center">
        <a
          href="https://github.com/yourusername"
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-text transition-colors"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
        <a
          href="https://twitter.com/yourusername"
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-text transition-colors"
          aria-label="Twitter"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
            <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
          </svg>
        </a>
        <a
          href="https://linkedin.com/in/yourusername"
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-text transition-colors"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
      </div>
    </header>

    <!-- Filters -->
    <TimelineFilters />

    <!-- Timeline -->
    <Timeline items={timelineItems} />
  </div>
</BaseLayout>
