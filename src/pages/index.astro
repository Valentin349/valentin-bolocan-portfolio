---
import Base from '../layouts/Base.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectRow from '../components/ProjectRow.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import { getCollection, getEntry } from 'astro:content';

const profile = (await getEntry('profile', 'me'))!;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const experience = (await getCollection('experience')).sort((a, b) => b.data.sort.valueOf() - a.data.sort.valueOf());
// Each timeline row shows its project's logo on the rail.
const logos = Object.fromEntries(projects.map((p) => [p.slug, p.data.icon]));
const timeline = (await getCollection('timeline')).sort((a, b) => b.data.sort.valueOf() - a.data.sort.valueOf());
---
<Base title={`${profile.data.name}: ${profile.data.role}`} description={profile.data.description}>
  <ProfileHeader profile={profile} />

  <section aria-labelledby="projects">
    <SectionHeader id="projects" title="Projects" meta={`${projects.length} projects`} />
    <ul class="bl-rows">
      {projects.map((p) => <li><ProjectRow project={p} /></li>)}
    </ul>
  </section>

  {experience.length > 0 && (
    <section aria-labelledby="experience">
      <SectionHeader id="experience" title="Experience" />
      <ol class="bl-timeline bl-timeline-undated">
        {experience.map(({ data: j }) => (
          <ExperienceEntry title={j.role} org={j.company} href={j.href} note={j.note} start={j.start} end={j.end} description={j.description} tags={j.tags} current={j.end === null} />
        ))}
      </ol>
    </section>
  )}

  {timeline.length > 0 && (
    <section aria-labelledby="timeline">
      <SectionHeader id="timeline" title="Timeline" />
      <ol class="bl-timeline bl-timeline-undated">
        {timeline.map((e) => <TimelineEntry entry={e} logo={e.data.project ? logos[e.data.project] : undefined} />)}
      </ol>
    </section>
  )}
</Base>
