---
import Base from '../../layouts/Base.astro';
import Metric from '../../components/Metric.astro';
import Chip from '../../components/Chip.astro';
import Button from '../../components/Button.astro';
import BuildStrip from '../../components/BuildStrip.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const p = project.data;
const { Content } = await project.render();
---
<Base title={`${p.name}: ${p.tagline}`} description={p.tagline}>
  <nav slot="nav" class="site-nav" aria-label="Site">
    <a href={url('/')}><Icon name="arrow-left" />All projects</a>
  </nav>

  <header class="project-head">
    <h1 class="bl-display">{p.name}</h1>
    <p class="project-tagline">{p.tagline}</p>
    <div class="project-facts">
      {p.metric && <Metric {...p.metric} />}
      <Chip items={p.tags} />
    </div>
    {p.links.length > 0 && (
      <div class="project-links">
        {p.links.map((l) => <Button label={l.label} href={l.href} variant="ghost" size="sm" />)}
      </div>
    )}
  </header>

  <section aria-labelledby="build-log">
    <header class="bl-section"><h2 id="build-log">Build log</h2>{p.stages.length > 0 && <div class="bl-section-meta">{p.stages.length} {p.stages.length === 1 ? 'screen' : 'screens'}</div>}</header>
    {p.stages.length > 0 ? (
      <BuildStrip stages={p.stages} label={`${p.name} screens, oldest first`} />
    ) : (
      <p class="bl-card-empty"><b>No screenshots yet</b>The build log starts with the first screen on a device.</p>
    )}
  </section>

  <section aria-labelledby="about" class="prose">
    <h2 id="about" class="sr-only">About {p.name}</h2>
    <Content />
  </section>
</Base>
