---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata; alt: string; version: string; date?: string; caption?: string;
  device?: 'phone' | 'browser'; url?: string; width?: number; eager?: boolean; id?: string;
}
const { src, alt, version, date, caption, device = 'phone', url, width, eager = false, id } = Astro.props;
const w = width ?? (device === 'browser' ? 420 : 200);
---
<figure id={id} class={`bl-frame bl-frame-${device}`} style={`--bl-frame-w:${w}px`}>
  <div class="bl-frame-device">
    {device === 'browser' && (
      <div class="bl-frame-bar" aria-hidden="true"><i></i><i></i><i></i>{url && <span class="bl-frame-url">{url}</span>}</div>
    )}
    <div class="bl-frame-screen">
      <Image src={src} alt={alt} width={w * 2} loading={eager ? 'eager' : 'lazy'} />
    </div>
  </div>
  <figcaption class="bl-frame-cap">
    <div class="bl-frame-tag"><b>{version}</b>{date && <> · {date}</>}</div>
    {caption && <div class="bl-frame-text">{caption}</div>}
  </figcaption>
</figure>
