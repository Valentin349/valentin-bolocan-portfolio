---
import Icon from './Icon.astro';
import { url, isExternal } from '../lib/url';
interface Props { label: string; href: string; variant?: 'primary' | 'secondary' | 'ghost'; size?: 'md' | 'sm'; arrow?: boolean }
const { label, href, variant = 'primary', size = 'md', arrow = true } = Astro.props;
const external = isExternal(href);
---
<a
  class:list={['bl-btn', `bl-btn-${variant}`, size === 'sm' && 'bl-btn-sm', arrow && 'bl-btn-has-arrow']}
  href={url(href)}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="bl-btn-label">{label}</span>
  {arrow && <Icon name={external ? 'arrow-up-right' : 'arrow-right'} />}
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
