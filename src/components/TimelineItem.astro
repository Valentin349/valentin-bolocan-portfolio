---
import { formatMonthYear } from '../utils/date';
import type { TimelineItem } from '../utils/timeline';

interface Props {
  item: TimelineItem;
  index: number;
}

const { item, index } = Astro.props;
const isEven = index % 2 === 0;

// Determine the display date and link based on item type
let displayDate: Date;
let itemLink: string;
let itemType: string;

if (item.type === 'blog') {
  displayDate = item.data.publishDate;
  itemLink = `/blog/${item.slug}`;
  itemType = 'Blog Post';
} else if (item.type === 'project') {
  displayDate = item.data.endDate || item.data.startDate;
  itemLink = `/projects/${item.slug}`;
  itemType = 'Project';
} else {
  displayDate = item.data.date;
  itemLink = `#${item.slug}`;
  itemType = 'Experiment';
}
---

<article class={`timeline-item ${isEven ? 'timeline-item-left' : 'timeline-item-right'} relative pb-24 group`} data-type={item.type}>
  <!-- Timeline dot (centered on md+, left on mobile) -->
  <div class="timeline-dot absolute w-3 h-3 bg-accent rounded-full border-4 border-background z-10"></div>

  <!-- Content wrapper -->
  <div class="timeline-content">
    <!-- Date -->
    <time
      datetime={displayDate.toISOString()}
      class="block text-sm text-text-muted mb-2 font-mono"
    >
      {formatMonthYear(displayDate)}
    </time>

  <!-- Card -->
  <div class="card group-hover:shadow-md transition-shadow">
    <!-- Type badge -->
    <div class="flex gap-2 mb-3 flex-wrap">
      <span class="px-3 py-1 bg-background text-text-muted text-xs rounded-full border border-border">
        {itemType}
      </span>
    </div>

    <!-- Title -->
    <h3 class="mb-2">
      <a href={itemLink} class="no-underline text-text hover:text-accent transition-colors">
        {item.data.title}
      </a>
    </h3>

    <!-- Description -->
    {item.type === 'blog' && (
      <div class="flex items-center gap-3 text-sm text-text-muted">
        {item.data.tags.length > 0 && (
          <div class="flex gap-2">
            {item.data.tags.map(tag => (
              <span>#{tag}</span>
            ))}
          </div>
        )}
        {item.data.readingTime && (
          <span>{item.data.readingTime} min read</span>
        )}
      </div>
    )}

    {item.type === 'project' && (
      <>
        <p class="text-text-muted mb-4">{item.data.shortDescription}</p>

        {item.data.techStack.length > 0 && (
          <div class="flex gap-2 flex-wrap mb-4">
            {item.data.techStack.map(tech => (
              <span class="px-2 py-1 bg-background text-text-muted text-xs rounded border border-border font-mono">
                {tech}
              </span>
            ))}
          </div>
        )}

        <div class="flex gap-4">
          {item.data.liveUrl && (
            <a
              href={item.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-text hover:text-accent transition-colors"
            >
              Live Site →
            </a>
          )}
          {item.data.githubUrl && (
            <a
              href={item.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-text hover:text-accent transition-colors"
            >
              GitHub →
            </a>
          )}
        </div>
      </>
    )}

    {item.type === 'experiment' && (
      <p class="text-text-muted">{item.data.description}</p>
    )}
  </div>
  </div>
</article>

<style>
  /* Mobile: items on left side */
  .timeline-item {
    opacity: 0;
    transform: translateY(20px);
    padding-left: 3rem; /* 48px */
  }

  .timeline-dot {
    left: 0;
    top: 0.375rem; /* 6px */
  }

  .timeline-content {
    width: 100%;
  }

  /* Tablet and up: centered timeline with alternating items */
  @media (min-width: 768px) {
    .timeline-item {
      padding-left: 0;
      padding-right: 0;
    }

    /* Left items (even index) */
    .timeline-item-left {
      padding-right: calc(50% + 2rem);
    }

    .timeline-item-left .timeline-content {
      text-align: right;
    }

    .timeline-item-left .timeline-dot {
      left: 50%;
      transform: translateX(-50%);
    }

    /* Right items (odd index) */
    .timeline-item-right {
      padding-left: calc(50% + 2rem);
    }

    .timeline-item-right .timeline-content {
      text-align: left;
    }

    .timeline-item-right .timeline-dot {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .timeline-item.visible {
    animation: slideUp 0.6s ease-out forwards;
  }
</style>
