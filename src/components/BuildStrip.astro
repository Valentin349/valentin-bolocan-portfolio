---
// A project's screenshots, oldest first, in a horizontal strip with a visible scrollbar and previous/next buttons.
import StageFrame from './StageFrame.astro';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';
interface Stage { src: ImageMetadata; alt: string; version: string; date?: string; caption?: string; device: 'phone' | 'browser'; url?: string }
interface Props { stages: Stage[]; label: string }
const { stages, label } = Astro.props;
---
<section class="bl-strip" data-strip aria-label={label}>
  <ol class="bl-strip-track" tabindex="0" aria-label={label}>
    {stages.map((s, i) => (
      <li class={`bl-strip-item bl-strip-item-${s.device}`}>
        <StageFrame {...s} width={s.device === 'browser' ? 480 : 240} eager={i < 3} />
      </li>
    ))}
  </ol>
  <button type="button" class="bl-strip-nav bl-strip-prev" aria-label="Previous screens" disabled><Icon name="arrow-left" /></button>
  <button type="button" class="bl-strip-nav bl-strip-next" aria-label="Next screens" disabled><Icon name="arrow-right" /></button>
</section>

<script>
  // The buttons scroll by most of a view; each is disabled (and hidden) at its end of the strip.
  for (const strip of document.querySelectorAll<HTMLElement>('[data-strip]')) {
    const track = strip.querySelector<HTMLElement>('.bl-strip-track')!;
    const prev = strip.querySelector<HTMLButtonElement>('.bl-strip-prev')!;
    const next = strip.querySelector<HTMLButtonElement>('.bl-strip-next')!;
    const rtl = getComputedStyle(track).direction === 'rtl' ? -1 : 1;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const at = Math.abs(track.scrollLeft);
      prev.disabled = at <= 1;
      next.disabled = at >= max - 1;
    };
    const step = (dir: number) => track.scrollBy({ left: dir * rtl * track.clientWidth * 0.8 });
    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  }
</script>
