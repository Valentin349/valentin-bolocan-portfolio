---
// This component will contain filter pills for timeline filtering
---

<div class="mb-16" id="timeline-filters">
  <h3 class="mb-6 text-lg font-medium">Filter by:</h3>

  <!-- Type filters -->
  <div class="mb-6">
    <div class="flex gap-2 flex-wrap">
      <button
        class="filter-pill active"
        data-filter-value="all"
      >
        All
      </button>
      <button
        class="filter-pill"
        data-filter-value="blog"
      >
        Blog Posts
      </button>
      <button
        class="filter-pill"
        data-filter-value="project"
      >
        Projects
      </button>
    </div>
  </div>
</div>

<script>
  // Client-side filtering logic
  let currentFilter = 'all';

  function applyFilters() {
    const items = document.querySelectorAll('.timeline-item');
    let visibleIndex = 0;

    items.forEach((item) => {
      const itemElement = item as HTMLElement;
      const itemType = itemElement.dataset.type;

      // Show all items if 'all' filter is active, otherwise filter by type
      if (currentFilter === 'all' || currentFilter === itemType) {
        itemElement.style.display = '';

        // Recalculate left/right positioning based on visible order
        itemElement.classList.remove('timeline-item-left', 'timeline-item-right');
        if (visibleIndex % 2 === 0) {
          itemElement.classList.add('timeline-item-left');
        } else {
          itemElement.classList.add('timeline-item-right');
        }

        visibleIndex++;
      } else {
        itemElement.style.display = 'none';
      }
    });
  }

  // Add click handlers to filter buttons
  document.querySelectorAll('.filter-pill').forEach((button) => {
    button.addEventListener('click', () => {
      const btn = button as HTMLButtonElement;
      const filterValue = btn.dataset.filterValue || '';

      // Remove active class from all buttons
      document.querySelectorAll('.filter-pill').forEach((b) => {
        b.classList.remove('active');
      });

      // Set new active filter
      currentFilter = filterValue;
      btn.classList.add('active');

      applyFilters();
    });
  });
</script>
