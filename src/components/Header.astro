---
const currentPath = Astro.url.pathname;
---

<header class="w-full py-12 border-b border-border">
  <nav class="max-w-4xl mx-auto px-6 flex items-center justify-between">
    <a href="/" class="text-2xl font-semibold no-underline hover:text-text-muted transition-colors">
      Valentin Bolocan
    </a>

    <div class="flex gap-12 items-center">
      <a
        href="/"
        class={`no-underline text-sm font-medium transition-colors ${currentPath === '/' ? 'text-text' : 'text-text-muted hover:text-text'}`}
      >
        Timeline
      </a>
      <a
        href="/about"
        class={`no-underline text-sm font-medium transition-colors ${currentPath === '/about' ? 'text-text' : 'text-text-muted hover:text-text'}`}
      >
        About
      </a>
      <a
        href="/cv"
        class={`no-underline text-sm font-medium transition-colors ${currentPath === '/cv' ? 'text-text' : 'text-text-muted hover:text-text'}`}
      >
        CV
      </a>
      <a
        href="/now"
        class={`no-underline text-sm font-medium transition-colors ${currentPath === '/now' ? 'text-text' : 'text-text-muted hover:text-text'}`}
      >
        Now
      </a>
    </div>
  </nav>
</header>
