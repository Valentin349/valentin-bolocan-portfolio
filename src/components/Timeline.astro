---
import TimelineItem from './TimelineItem.astro';
import type { TimelineItem as TItem } from '../utils/timeline';

interface Props {
  items: TItem[];
}

const { items } = Astro.props;
---

<div class="relative timeline-container">
  <!-- Vertical timeline line (centered on lg+, left on smaller) -->
  <div class="timeline-line-track"></div>
  <div class="timeline-line-progress"></div>

  <!-- Timeline items -->
  <div class="space-y-0">
    {items.map((item, index) => (
      <TimelineItem item={item} index={index} />
    ))}
  </div>

  {items.length === 0 && (
    <div class="text-center py-16">
      <p class="text-text-muted">No items match your filters.</p>
    </div>
  )}
</div>

<style>
  .timeline-line-track {
    @apply absolute top-0 bottom-0 w-0.5 bg-border;
    left: 0;
  }

  .timeline-line-progress {
    @apply absolute top-0 w-0.5 bg-accent;
    left: 0;
    height: 0;
    transition: height 0.1s linear;
  }

  @media (min-width: 768px) {
    .timeline-line-track,
    .timeline-line-progress {
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>

<script>
  // Intersection Observer for scroll animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px',
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observe all timeline items
  document.querySelectorAll('.timeline-item').forEach((item) => {
    observer.observe(item);
  });

  // Animated timeline progress on scroll
  function updateTimelineProgress() {
    const timeline = document.querySelector('.timeline-container');
    const progressLine = document.querySelector('.timeline-line-progress') as HTMLElement;

    if (!timeline || !progressLine) return;

    // Calculate total page scroll progress (0 at top, 1 at bottom)
    const windowHeight = window.innerHeight;
    const documentHeight = document.documentElement.scrollHeight;
    const scrollTop = window.scrollY;
    const maxScroll = documentHeight - windowHeight;
    const scrollPercentage = maxScroll > 0 ? scrollTop / maxScroll : 0;

    // Apply scroll percentage to timeline height
    const timelineHeight = timeline.offsetHeight;
    const progressHeight = timelineHeight * scrollPercentage;

    progressLine.style.height = `${progressHeight}px`;
  }

  // Update on scroll and initial load
  window.addEventListener('scroll', updateTimelineProgress, { passive: true });
  window.addEventListener('resize', updateTimelineProgress, { passive: true });
  updateTimelineProgress();
</script>
